{
  "name": "@lyeve/ui-kit",
  "version": "0.6.2",
  "description": "A clean, accessible, palette-aware Svelte 5 component library — the design system behind LyEve.",
  "license": "MIT",
  "author": "LyEve Labs <hello@lyeve.com>",
  "homepage": "https://ui.lyeve.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyEve-Labs/ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/LyEve-Labs/ui-kit/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "components",
    "ui-kit",
    "tailwindcss",
    "design-system",
    "lyeve"
  ],
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "cookie": ">=0.7.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm package",
    "build:docs": "vite build",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "pnpm package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "files": [
    "dist",
    "src/lib/styles",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/lib/styles/theme.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "@lucide/svelte": "^0.511.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.61.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "publint": "^0.2.12",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
