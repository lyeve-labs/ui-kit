{
  "name": "@lyeve-labs/ui-kit",
  "version": "0.63.1",
  "description": "A clean, accessible, palette-aware Svelte 5 component library. The design system behind LyEve.",
  "license": "MIT",
  "author": "LyEve Labs <hello@lyeve.com>",
  "homepage": "https://ui-kit.lyeve.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyeve-labs/ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/lyeve-labs/ui-kit/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "components",
    "ui-kit",
    "tailwindcss",
    "design-system",
    "lyeve"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm version:check && svelte-package && node scripts/site-css.mjs && publint && node scripts/check-dist.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "package": "pnpm version:check && svelte-package && node scripts/site-css.mjs && publint",
    "prepublishOnly": "pnpm package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ct": "playwright test --config playwright-ct.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "files": [
    "dist",
    "src/lib/styles",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/lib/styles/theme.css",
    "./site.css": "./dist/site.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@lucide/svelte": ">=0.511.0 <2",
    "svelte": "^5.0.0",
    "tailwindcss": "^4"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lucide/svelte": "^1.74.0",
    "@playwright/experimental-ct-svelte": "1.58.2",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "0.8.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
